# ==============================================================================
# Environmental Configuration for LLM multi-crisis trading backtest framework
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Key Configuration
# ------------------------------------------------------------------------------
# Set the API key for your chosen provider. If using OpenRouter, set OPENROUTER_API_KEY.
# If calling Gemini directly via Google AI Studio, set GEMINI_API_KEY.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# 2. LLM Model Settings
# ------------------------------------------------------------------------------
# Recommended model names:
# - OpenRouter: meta-llama/llama-3.3-70b-instruct or deepseek/deepseek-chat
# - Direct Gemini: gemini-1.5-flash or gemini-1.5-pro
TRADEBOT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
TRADEBOT_LLM_TEMPERATURE=0.2
TRADEBOT_LLM_MAX_TOKENS=2000

# Budget tokens for reasoning models (e.g. DeepSeek V3/R1 if supported)
# TRADEBOT_LLM_THINKING={"budget_tokens":512}

# ------------------------------------------------------------------------------
# 3. Backtest Configurations
# ------------------------------------------------------------------------------
# Symbols must match the prefixes of CSV files in the `dataset/` directory.
# E.g. AAPL, gold (case insensitive as file names are resolved automatically)
BACKTEST_SYMBOLS=AAPL
BACKTEST_INTERVAL=1d
BACKTEST_START_CAPITAL=1000

# Crisis sub-sample periods evaluated in the paper:
# - 2008-2009 Global Financial Crisis: 2008-01-01 to 2009-12-31
# - 2020-2021 COVID-19 Volatility: 2020-01-01 to 2021-12-31
# - 2022-2023 Fed Tightening Cycle: 2022-01-01 to 2023-12-31
BACKTEST_START=2008-01-01
BACKTEST_END=2009-12-31

# ------------------------------------------------------------------------------
# 4. Telegram Notifications & Logging (Optional)
# ------------------------------------------------------------------------------
# Set to true to disable telegram log alerts during backtesting
BACKTEST_DISABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_SIGNALS_CHAT_ID=your_telegram_signals_chat_id_here

# ------------------------------------------------------------------------------
# 5. Live / Paper Trading Configuration (Optional & Caution)
# ------------------------------------------------------------------------------
# Hyperliquid live settings
HYPERLIQUID_LIVE_TRADING=false
HYPERLIQUID_WALLET_ADDRESS=0xyour_wallet_address_here
HYPERLIQUID_PRIVATE_KEY=your_private_key_or_vault_key_here
HYPERLIQUID_CAPITAL=500.0

# General paper trading initial balance
PAPER_START_CAPITAL=10000.0
SORTINO_RISK_FREE_RATE=0.0
