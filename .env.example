# LLM Provider Configuration
# ---------------------------
# To use Google Gemini directly (Free/Fast - Recommended):
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Model examples: gemini-1.5-flash, gemini-1.5-pro
TRADEBOT_LLM_MODEL=google/gemini-1.5-flash

# To use OpenRouter (Multiple providers):
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Examples: meta-llama/llama-3.1-70b-instruct, google/gemini-flash-1.5, deepseek/deepseek-chat
# TRADEBOT_LLM_MODEL=google/gemini-flash-1.5

# Advanced LLM settings
TRADEBOT_LLM_TEMPERATURE=0.7
TRADEBOT_LLM_MAX_TOKENS=2000
# TRADEBOT_LLM_THINKING={"budget_tokens":512} # Only for models that support reasoning (e.g. DeepSeek)

# Capital settings
PAPER_START_CAPITAL=10000.0

# Risk-free rate for Sortino calculation (annualized, e.g., 0.03 = 3%)
SORTINO_RISK_FREE_RATE=0.0

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=8980005884:AAHq_TARAfHrsIhJDwWcn7AiJx2LGC6krFA
TELEGRAM_CHAT_ID=6708764126

# Optional: Telegram Signals Chat ID
TELEGRAM_SIGNALS_CHAT_ID=your_optional_signals_chat_id_here

# Hyperliquid Live Trading (optional - DANGER: real money)
HYPERLIQUID_LIVE_TRADING=false
HYPERLIQUID_WALLET_ADDRESS=0xyour_wallet_address
HYPERLIQUID_PRIVATE_KEY=your_private_key_or_vault_key
